FROM eclipse-temurin:21-jdk-jammy AS build

WORKDIR /workspace

COPY app/spring-petclinic/mvnw .
COPY app/spring-petclinic/.mvn .mvn
COPY app/spring-petclinic/pom.xml .

RUN chmod +x mvnw && ./mvnw dependency:go-offline -B

COPY app/spring-petclinic/src src

RUN ./mvnw clean package -DskipTests


FROM eclipse-temurin:21-jre-jammy AS runtime

WORKDIR /app

RUN groupadd --system --gid 10001 petclinic \
    && useradd --system \
        --uid 10001 \
        --gid petclinic \
        --home-dir /app \
        --shell /usr/sbin/nologin \
        petclinic

COPY --chown=10001:10001 --from=build /workspace/target/*.jar app.jar

USER 10001:10001

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]